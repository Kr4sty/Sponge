{
 "model": {
  "type": "select",
  "property": "custom_model_data",
  "fallback": {
   "type": "model",
    "model": "item/wooden_shovel"
  },
  "cases": [
   {
    "when": "tungsten_dagger",
    "model": {
     "type": "model",
     "model": "item/weapons/tungsten_dagger"
    }
   },
    {
    "when": "farm_sickle",
    "model": {
     "type": "model",
     "model": "item/weapons/farm_sickle"
    }
   }
  ]
 }
} 